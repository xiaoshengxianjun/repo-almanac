{
  "name": "repo-almanac",
  "productName": "项目志",
  "version": "0.1.8",
  "private": true,
  "description": "An evidence-based field guide to local codebases.",
  "repository": {
    "type": "git",
    "url": "https://github.com/xiaoshengxianjun/repo-almanac.git"
  },
  "main": "desktop/main.cjs",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "start": "npm run build && electron .",
    "format:check": "prettier --check \"{src,desktop,engine,shared,scripts,tests}/**/*.{ts,tsx,css,cjs,mjs}\"",
    "build": "node node_modules/typescript/bin/tsc --noEmit && vite build",
    "test": "node --test tests/*.test.cjs",
    "package": "npm run build && node scripts/package.cjs"
  },
  "dependencies": {
    "@typescript/typescript6": "6.0.2",
    "@vue/compiler-sfc": "3.5.46",
    "ignore": "7.0.17",
    "semver": "7.8.6"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "echarts": "^6.1.0",
    "electron": "^45.5.0",
    "prettier": "^3.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.4.0"
  }
}
